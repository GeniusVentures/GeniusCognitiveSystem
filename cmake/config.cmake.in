@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(OpenSSL REQUIRED)
find_dependency(libsecp256k1 CONFIG REQUIRED)
find_dependency(fmt CONFIG REQUIRED)
find_dependency(spdlog CONFIG REQUIRED)
find_dependency(Boost REQUIRED COMPONENTS date_time filesystem random regex system thread log log_setup program_options json)
find_dependency(nlohmann_json CONFIG REQUIRED)

include("${CMAKE_CURRENT_LIST_DIR}/GeniusCogntiveSystemTargets.cmake")
